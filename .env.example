# Variables lues par docker compose (copier en .env à côté de docker-compose.yml). Ne jamais versionner .env.

# Sauvegarde de la base (docs/17)
BACKUP_PASSPHRASE=          # 32 caractères aléatoires ou plus ; à garder aussi HORS du serveur (coffre-fort de mots de passe)
BACKUP_TIME=02:30           # heure UTC
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
# Copie hors serveur (Hetzner Object Storage, OVH Object Storage, Backblaze B2, AWS S3…)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=         # ex. https://fsn1.your-objectstorage.com (Hetzner) ; vide pour AWS
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=eu-central
# Alerte en cas d'échec : URL qui reçoit un POST JSON {"text": "..."} (Slack, Google Chat, Discord /slack…)
BACKUP_ALERT_URL=
