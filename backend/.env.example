NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://smarttontine:smarttontine@localhost:5432/smarttontine
JWT_SECRET=change-me-en-production
# Agrégateur de paiement (CinetPay, PayDunya, Wave Business...). "mock" en développement.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# SMS OTP (Orange SMS API, Twilio...). "console" en développement.
SMS_PROVIDER=console
# URL publique de l'API (adresse de notification donnée à l'agrégateur : <URL>/webhooks/cinetpay)
PUBLIC_API_URL=
# Back-office : double authentification obligatoire (true par défaut en production)
ADMIN_MFA_REQUIRED=false
# Clé de chiffrement des secrets 2FA (sinon dérivée de JWT_SECRET)
MFA_ENCRYPTION_KEY=
# Une seule instance exécute les tâches planifiées (false sur les autres)
RUN_JOBS=true
