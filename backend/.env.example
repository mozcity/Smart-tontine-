NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://smarttontine:smarttontine@localhost:5432/smarttontine
JWT_SECRET=change-me-en-production
# Agrégateur de paiement (CinetPay, PayDunya, Wave Business...). "mock" en développement.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook
# CinetPay API v1 : identifiants par pays (espace marchand). sk_test_… = bac à sable, sk_live_… = production.
CINETPAY_COUNTRY=BF
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Autres pays : CINETPAY_API_KEY_CI / CINETPAY_API_PASSWORD_CI, _SN, _ML, _TG, _BJ, _NE
# URL publiques (webhooks et retours de paiement)
PUBLIC_API_URL=https://api.smarttontine.app
PUBLIC_WEB_URL=https://smarttontine.app

# SMS (OTP, rappels) : liste ordonnée, le suivant sert de secours. "console" en développement.
SMS_PROVIDER=console
# SMS_PROVIDER=orange,twilio
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2260000
ORANGE_SMS_SENDER_NAME=SmartTontine
ORANGE_SMS_COUNTRY_PREFIX=+226
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Jeton secret inclus dans l'URL des accusés de réception Orange (32 caractères aléatoires)
SMS_WEBHOOK_TOKEN=
# URL publique de l'API (adresse de notification donnée à l'agrégateur : <URL>/webhooks/cinetpay)
PUBLIC_API_URL=
# Back-office : double authentification obligatoire (true par défaut en production)
ADMIN_MFA_REQUIRED=false
# Clé de chiffrement des secrets 2FA (sinon dérivée de JWT_SECRET)
MFA_ENCRYPTION_KEY=
# Une seule instance exécute les tâches planifiées (false sur les autres)
RUN_JOBS=true

# Chiffrement au repos des pièces d'identité (obligatoire en production) : 32 caractères aléatoires ou plus
KYC_ENCRYPTION_KEY=
# Code OTP affiché à l'écran en développement (avec SMS_PROVIDER=console). Interdit en production.
# OTP_DEV_ECHO=false

# Compte de revue des stores (Apple / Google) : numéro et code OTP fixes, sans SMS. Laisser vide hors période de revue.
REVIEW_PHONE=
REVIEW_OTP=
# Origines web autorisées (CORS) en production, séparées par des virgules
CORS_ORIGINS=https://smarttontine.app
